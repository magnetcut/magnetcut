{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagnetCut",
  "identifier": "it.salamacchine.magnetcut",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web/out",
    "beforeDevCommand": { "script": "bun run dev:web", "cwd": "../.." },
    "beforeBuildCommand": { "script": "bun run build:web", "cwd": "../.." }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MagnetCut",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "A video editor that keeps everything on your computer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/MagnetCut.icon"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQURCRjVCQTNBNTU5ODUKUldTRldhV2pXNyt0N2Q2Wm50cHRVWXQ3UVJEaVJweHYxUUhGK3YzZ0IweWZOd2tUL0UwUWRJMEEK",
      "endpoints": [
        "https://github.com/magnetcut/magnetcut/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
