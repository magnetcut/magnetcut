# release.env.example: what apps/desktop/scripts/release.sh signs with.
#
# Copy it to apps/desktop/release.env (gitignored) and fill it in, or export
# the variables in your shell. docs/RELEASING.md has the whole process.

# Your Apple Developer Team ID (10 characters): the app and the disk image
# are signed with this team's "Developer ID Application" identity, from your
# keychain.
TEAM_ID="YOURTEAMID"

# Notarization: a notarytool keychain profile, created once with
#   xcrun notarytool store-credentials "magnetcut-notary" \
#     --apple-id "you@example.com" --team-id "$TEAM_ID" \
#     --password "<app-specific password>"
# A profile you already have for another app works too. Or an App Store
# Connect API key: APPLE_API_KEY_PATH, APPLE_API_KEY_ID and APPLE_API_ISSUER.
NOTARY_PROFILE="magnetcut-notary"

# The updater's private key (cargo tauri signer generate -w <file>): its
# public half is plugins.updater.pubkey in apps/desktop/tauri.conf.json, and
# installed copies take only updates it signed. Keep it out of the repository,
# somewhere backed up.
UPDATER_KEY="$HOME/path/to/magnetcut-updater.key"

# Its password, as a generic password in the login keychain (the item's
# service name), or in TAURI_SIGNING_PRIVATE_KEY_PASSWORD.
UPDATER_KEY_PASSWORD_ITEM="magnetcut-updater-key"
